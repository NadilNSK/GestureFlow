{
  "camera": {
    "device_index": 1,
    "backend": "DSHOW",
    "frame_width": 640,
    "frame_height": 480,
    "fps": 30,
    "flip_horizontal": true,
    "use_mock_camera": false
  },
  "tracking": {
    "num_hands": 2,
    "min_detection_confidence": 0.7,
    "min_presence_confidence": 0.5,
    "min_tracking_confidence": 0.5,
    "model_path": "assets/models/hand_landmarker.task"
  },
  "gestures": {
    "pinch_threshold": 0.065,
    "pinch_release_threshold": 0.085,
    "confirmation_frames": 3,
    "loss_tolerance_frames": 3,
    "preferred_handedness": "Right"
  },
  "controller": {
    "smoothing_factor": 7,
    "movement_threshold": 3,
    "click_cooldown_ms": 400,
    "scroll_speed": 3,
    "mouse_control_enabled_default": false,
    "cursor_sensitivity": 1.0,
    "cursor_smoothing": 0.35,
    "cursor_dead_zone": 2.5,
    "tracking_region_margin": 0.15,
    "cursor_update_interval": 0.01,
    "cursor_jump_threshold": 250.0,
    "smoothing_filter_type": "one_euro",
    "one_euro_min_cutoff": 1.0,
    "one_euro_beta": 0.007,
    "one_euro_d_cutoff": 1.0,
    "precision_mode": false,
    "precision_multiplier": 0.35,
    "max_cursor_velocity": 4000.0,
    "left_click_enabled": true,
    "right_click_enabled": true,
    "double_click_enabled": true,
    "drag_enabled": true,
    "scroll_enabled": true,
    "click_cooldown": 0.20,
    "double_click_interval": 0.35,
    "drag_hold_duration": 0.45,
    "scroll_sensitivity": 1.0,
    "scroll_dead_zone": 0.008,
    "scroll_update_interval": 0.04
  },
  "ui": {
    "window_width": 1100,
    "window_height": 720,
    "preview_width": 640,
    "preview_height": 480,
    "theme": "dark",
    "show_landmarks": true,
    "show_fps": true,
    "show_gesture_label": true
  },
  "logging": {
    "level": "INFO",
    "file": "logs/gestureflow.log",
    "max_bytes": 5242880,
    "backup_count": 3
  },
  "pyautogui": {
    "failsafe": true,
    "pause": 0.0
  }
}